# Core app
APP_ENV=development
POSTGRES_USER=multimodal_rag
POSTGRES_PASSWORD=replace-with-a-strong-database-password
LLM_PROVIDER=openrouter
USE_VECTOR_DB=true
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
MAX_UPLOAD_MB=25
MAX_ACTIVE_USERS=30
SESSION_TTL_SECONDS=1800
AGENT_CACHE_SIZE=30
CHAT_HISTORY_RETENTION_DAYS=30
MAX_FILES_PER_USER=30
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
CHAT_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=10
ALLOWED_ORIGINS=http://localhost:8501

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multimodal_rag

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
PROVIDER_ENCRYPTION_KEY=replace-with-a-fernet-key-generated-by-cryptography
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_BACKEND=jwt

# Providers
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=minimax/minimax-m3:free
GOOGLE_API_KEY=
SUPPORTED_PROVIDERS=google,openrouter,groq

# Local file storage
UPLOAD_DIR=./data/uploads
DB_PATH=./data/rag.sqlite3
CHAT_HISTORY_DB_PATH=./data/chat_history.sqlite3
PROVIDER_SETTINGS_DB_PATH=./data/provider_settings.sqlite3
